# Production Environment Example for Synthetic Data Platform Backend
# Copy to .env and adjust values. All secrets should be rotated regularly.

# --- Core Application ---
PROJECT_NAME="Synthetic Data Platform"
API_V1_STR="/api/v1"
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="CHANGE_ME_LONG_RANDOM"
APP_ENV=production
APP_INSTANCE_ID=prod-1
LOG_LEVEL=info
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database (prefer single DATABASE_URL) ---
# Async SQLAlchemy URL
DATABASE_URL="postgresql+asyncpg://app_user:strong_password@db:5432/sdp"
# Or specify individual fields (DATABASE_URL takes precedence when set)
POSTGRES_SERVER=db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=strong_password
POSTGRES_DB=sdp
POSTGRES_PORT=5432
DB_SCHEMA=synthetic_data
# Optional isolated test schema (not used in prod):
TESTING_DB_SCHEMA=
USE_TESTING_SCHEMA=false
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20
DB_CONN_TIMEOUT=10

# --- Redis (for caching, future rate limiting, tasks) ---
REDIS_URL=redis://:strong_password@redis:6379/0
# Or use individual fields
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Object Storage (MinIO / S3 compatible) ---
MINIO_ENDPOINT="minio:9000"
MINIO_ACCESS_KEY="CHANGE_ME_MINIO_ACCESS"
MINIO_SECRET_KEY="CHANGE_ME_MINIO_SECRET"
MINIO_BUCKET="synthetic-data"
MINIO_SECURE=true
MINIO_REGION="us-east-1"

# --- Security / Auth ---
AUTH_DISABLED=false
API_KEY_HASH_ALGO=sha256
# OIDC (uncomment and fill)
#OIDC_ISSUER=https://login.example.com/realms/main
#OIDC_CLIENT_ID=sdp-backend
#OIDC_CLIENT_SECRET=********
#OIDC_REDIRECT_URI=https://app.example.com/oidc/callback
#OIDC_SCOPES=openid profile email offline_access

# --- LLM Providers ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_BASE_URL=https://api.anthropic.com
OLLAMA_BASE_URL=http://ollama:11434
LMSTUDIO_BASE_URL=http://lmstudio:1234
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini

# --- Inference & Rate Limiting ---
INFER_RATE_LIMIT_PER_MINUTE=60
MAX_INFER_COLUMNS=500
DEFAULT_INFER_TEMPERATURE=0.2
FF_ENABLE_RATE_LIMIT_AUDIT=true
FF_ENABLE_PROBE_AUDIT=true
FF_ENABLE_DISCOVERY_CACHE=true

# --- Observability ---
ENABLE_METRICS=true
ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http
OTEL_SERVICE_NAME=synthetic-data-backend
SENTRY_DSN=

# --- Auditing & Retention ---
AUDIT_RETENTION_DAYS=90

# --- Encryption (KMS-provided or vaulted) ---
# 32-byte base64 key (example ONLY; replace!)
ENCRYPTION_KEK=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Feature Flags ---
# Already declared above for auditing; add future conditional features here

# --- Misc Tuning ---
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 days
MAX_ROWS_PER_GENERATION=1000000
DEFAULT_ROWS_PER_GENERATION=1000

# --- CORS (prefer JSON array) ---
BACKEND_CORS_ORIGINS=["https://app.example.com","https://admin.example.com"]
# Public URLs for callbacks / artifact links
FRONTEND_URL=https://app.example.com
BACKEND_PUBLIC_URL=https://api.example.com
# Public URLs (optional but recommended for link generation / callbacks)
FRONTEND_URL=https://app.example.com
BACKEND_PUBLIC_URL=https://api.example.com

# --- Logging Hints ---
# Use structured logging in container runtime: ensure log level via LOG_LEVEL

# --- Notes ---
# 1. Do NOT commit the real production .env to source control.
# 2. Rotate OPENAI/ANTHROPIC keys regularly.
# 3. Consider replacing in-memory rate limiter with Redis LUA script (uses REDIS_URL).
# 4. Set OTEL_EXPORTER_OTLP_ENDPOINT only if collector is deployed.
# 5. Use a secrets manager for long-term secret distribution.
