# Environment variables for development

# Optional: Full Postgres URL takes precedence over the individual POSTGRES_* fields
# For async SQLAlchemy, use the asyncpg scheme as shown below
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/synthetic_data_platform
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=synthetic_data_platform
POSTGRES_PORT=5432

# Database schemas
# Application default schema
DB_SCHEMA=synthetic_data
# Separate schema used during tests (if set)
TESTING_DB_SCHEMA=testing_synthetic_data

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Optional: set if your Redis requires authentication
REDIS_PASSWORD=

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=synthetic-data
# You may also specify a scheme (http/https). If omitted, HTTP is assumed.
# MINIO_ENDPOINT=http://localhost:9000

# API Configuration
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OIDC (OpenID Connect) configuration for frontend login (scaffold)
# Generic provider settings; set these to enable login redirect + callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
# Space-separated list
OIDC_SCOPES=openid profile email

# Security headers
# API keys are sent via X-API-Key header; Authorization is reserved for OIDC/JWT

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Data generation limits
MAX_ROWS_PER_GENERATION=1000000
DEFAULT_ROWS_PER_GENERATION=1000