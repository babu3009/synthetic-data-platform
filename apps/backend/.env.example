###########################################################################
# Backend Environment Example (.env.example)
# Copy to .env and fill in real secrets. Do NOT commit actual sensitive values.
###########################################################################

## ------------------------------------------------------------------------
## Database Configuration
## ------------------------------------------------------------------------
# Optional full URL (takes precedence over individual POSTGRES_* fields)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/synthetic_data_platform
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=synthetic_data_platform
POSTGRES_PORT=5432
DB_SCHEMA=synthetic_data
TESTING_DB_SCHEMA=testing_synthetic_data

## ------------------------------------------------------------------------
## Application Settings
## ------------------------------------------------------------------------
PROJECT_NAME=Synthetic Data Platform
VERSION=0.1.0
API_V1_STR=/api/v1
APP_ENV=local                 # local|staging|prod
APP_INSTANCE_ID=dev-1         # differentiate instances in logs

## ------------------------------------------------------------------------
## CORS / External URLs
## ------------------------------------------------------------------------
# Comma-separated origins (or JSON array if loader expects it)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

## ------------------------------------------------------------------------
## Redis Settings (override with REDIS_URL if present)
## ------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=

## ------------------------------------------------------------------------
## MinIO Settings
## ------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=synthetic-data
MINIO_SECURE=false
MINIO_REGION=us-east-1

## ------------------------------------------------------------------------
## Security / Auth Settings
## ------------------------------------------------------------------------
SECRET_KEY=your-super-secret-key-change-in-production
AUTH_DISABLED=false                   # ONLY true for local debugging
ACCESS_TOKEN_EXPIRE_MINUTES=10080
API_KEY_HASH_ALGO=sha256

# OIDC (leave blank to disable login redirect flow)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OIDC_SCOPES=openid profile email

## ------------------------------------------------------------------------
## Data Generation Settings
## ------------------------------------------------------------------------
MAX_ROWS_PER_GENERATION=1000000
DEFAULT_ROWS_PER_GENERATION=1000
MAX_INFER_COLUMNS=500
DEFAULT_INFER_TEMPERATURE=0.2

## ------------------------------------------------------------------------
## LLM Provider Configuration (optional)
## ------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234
DEFAULT_LLM_PROVIDER=
DEFAULT_LLM_MODEL=

## ------------------------------------------------------------------------
## Inference & Rate Limiting
## ------------------------------------------------------------------------
INFER_RATE_LIMIT_PER_MINUTE=60

## ------------------------------------------------------------------------
## Observability
## ------------------------------------------------------------------------
LOG_LEVEL=info
ENABLE_METRICS=true
ENABLE_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http
OTEL_SERVICE_NAME=synthetic-data-backend
SENTRY_DSN=

## ------------------------------------------------------------------------
## Audit / Retention
## ------------------------------------------------------------------------
AUDIT_RETENTION_DAYS=30

## ------------------------------------------------------------------------
## Feature Flags
## ------------------------------------------------------------------------
FF_ENABLE_DISCOVERY_CACHE=true
FF_ENABLE_PROBE_AUDIT=true
FF_ENABLE_RATE_LIMIT_AUDIT=true

## ------------------------------------------------------------------------
## Database Pool Tuning
## ------------------------------------------------------------------------
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_CONN_TIMEOUT=10

## ------------------------------------------------------------------------
## Encryption (future expansion)
## ------------------------------------------------------------------------
ENCRYPTION_KEK=

## ------------------------------------------------------------------------
## Notes
## ------------------------------------------------------------------------
# - Replace SECRET_KEY and any *_API_KEY values in real deployments.
# - If using tracing, set ENABLE_TRACING=true and OTEL_EXPORTER_OTLP_ENDPOINT.
# - For multi-instance rate limiting move to Redis or another centralized store.
# - DEFAULT_LLM_PROVIDER/MODEL allow auto-populating new project settings.